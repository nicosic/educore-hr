{
  "name": "educore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "check": "astro check",
    "cf:typegen": "wrangler types",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "seed:local": "wrangler d1 execute DB --local --file scripts/seed-local.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run seed:local",
    "db:migrate:preview": "bash scripts/cf.sh npx wrangler d1 migrations apply DB -c wrangler.jsonc --env preview --remote",
    "deploy:preview": "CLOUDFLARE_ENV=preview PUBLIC_NOINDEX=1 astro build && bash scripts/cf.sh npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "^7.4.12",
    "drizzle-orm": "^0.45.4",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@tailwindcss/vite": "^4.3.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261116.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.5": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
