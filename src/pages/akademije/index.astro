---
import Base from "@/layouts/Base.astro";
import Card from "@/components/Card.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { academies, overviewTones } from "@/data/academies";
---
<Base title="Akademije" description="Šest akademija meet.hr ekosustava: vodstvo, nabava, ugovori, kibernetička sigurnost, usklađenost i razvoj zaposlenika.">
  <section class="container-page pt-14 md:pt-20">
    <SectionHeading as="h1" eyebrow="Šest akademija" title="Jedan ekosustav znanja" highlight="ekosustav" lead="Šest povezanih područja za ljude, timove i organizacije. Svaka akademija okuplja stručnjake iz prakse i programe od uvodnih radionica do naprednih edukacija." />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        academies.map((a, i) => (
          <Card title={a.name} tone={overviewTones[i]} href={`/akademije/${a.slug}`} size="lg">
            <p class="font-medium">{a.headline}</p>
            <p class="mt-2 text-ink/80">{a.short}</p>
          </Card>
        ))
      }
    </div>
  </section>
</Base>
