---
import Base from "@/layouts/Base.astro";
import EventCard from "@/components/EventCard.astro";
import FormStatus from "@/components/FormStatus.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { featuredEvent } from "@/data/events";
import { photos } from "@/data/photos";
import { formatEur } from "@/lib/money";
import { fromPrices, listPublicEvents } from "@/server/events";

export const prerender = false;

const now = Date.now();
const list = await listPublicEvents(Astro.locals.db, now);
const prices = await fromPrices(Astro.locals.db, list.map((e) => e.id), now);
// Javni popis smije kratko u cache (CDN i preglednik).
Astro.response.headers.set("cache-control", "public, max-age=60, s-maxage=60");
const steps = [
  { title: "Uživo ili online", text: "Za svaki događaj birate mjesto u dvorani ili online sudjelovanje preko Zooma, s osobnom poveznicom za ulaz." },
  { title: "Grupne prijave", text: "Prijavite cijeli tim u jednoj narudžbi i dobijte jedan račun na tvrtku, uz grupni popust." },
  { title: "Potvrda i materijali", text: "Nakon edukacije dobivate potvrdu o sudjelovanju i pristup materijalima u svom korisničkom prostoru." },
];
---
<Base title="Događanja" description="Nadolazeće edukacije, radionice i masterclassovi platforme meet.hr, uživo i online.">
  <section class="container-page pt-14 md:pt-20">
    <SectionHeading
      as="h1"
      eyebrow="Događanja"
      title="Nadolazeće edukacije"
      highlight="edukacije"
      lead={list.length > 0
        ? "Prijavite se uživo ili online. Za grupne prijave cijelog tima izdajemo jedan račun na tvrtku."
        : "Prijave za prve edukacije otvaramo početkom 2027. Ostavite e-adresu i prvi ćete saznati termin i cijenu."}
    />
  </section>

  {
    list.length > 0 ? (
      <section class="container-page mt-12 grid gap-5 lg:grid-cols-2">
        {list.map((e) => (
          <EventCard event={e} fromPrice={prices[e.id] != null ? formatEur(prices[e.id]) : null} />
        ))}
      </section>
    ) : (
      <section class="container-page mt-12">
        <article class="grid overflow-hidden rounded-[1.75rem] bg-stone lg:grid-cols-2">
          <div class="flex flex-col justify-between p-8 md:p-12">
            <div>
              <p class="eyebrow">Najava • {featuredEvent.when}</p>
              <h2 class="h-section mt-4">{featuredEvent.title}</h2>
              <p class="mt-5 text-lg">{featuredEvent.question}</p>
            </div>
            <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-3">
              {featuredEvent.tags.map((t) => (
                <li class="flex items-center gap-3 font-medium text-ink">
                  <span class="size-2.5 rounded-full bg-neon-pink ring-4 ring-neon-pink/20" aria-hidden="true" />
                  <span class="first-letter:uppercase">{t}</span>
                </li>
              ))}
            </ul>
          </div>
          <img src={photos.event.src} alt={photos.event.alt} width="1200" height="820" class="h-full min-h-64 w-full object-cover" />
        </article>
      </section>
    )
  }

  <section class="container-page mt-12 md:mt-16">
    <form id="forma" method="post" action="/api/obavijesti" class="grid gap-8 rounded-[1.75rem] bg-night p-8 text-white/70 md:p-12 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <div>
        <h2 class="h-section !text-white">Budite <span class="mark mark-dark">prvi</span> na listi</h2>
        <p class="mt-4 leading-relaxed">Poslat ćemo vam e-poruku kad otvorimo nove prijave. Bez spama, a odjaviti se možete jednim klikom.</p>
      </div>
      <div>
        <FormStatus success="Hvala! Javit ćemo vam se kad otvorimo prijave." error="Upišite ispravnu e-adresu i potvrdite privolu." />
        <div class="flex flex-col gap-3 rounded-[2rem] bg-white p-1.5 sm:flex-row">
          <label class="block flex-1">
            <span class="sr-only">E-pošta</span>
            <input class="field !rounded-full !border-0 !bg-transparent text-ink" type="email" name="email" required maxlength="254" autocomplete="email" placeholder="vasa@adresa.hr" />
          </label>
          <button class="btn bg-neon text-ink hover:bg-ink hover:text-neon">Obavijesti me</button>
        </div>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Web stranica <input name="web" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="mt-4 flex gap-3 text-sm">
          <input type="checkbox" name="privola" value="da" required class="mt-0.5 size-5 accent-neon" />
          <span>Pristajem primati obavijesti o edukacijama platforme meet.hr. <a href="/privatnost" class="text-white underline">Zaštita privatnosti</a></span>
        </label>
      </div>
    </form>
  </section>

  <section class="container-page py-20 md:py-28">
    <SectionHeading title="Kako izgleda prijava" highlight="prijava" center />
    <ol class="mt-16 grid gap-x-10 gap-y-12 md:grid-cols-3">
      {
        steps.map((st, i) => (
          <li class="relative pt-8">
            <span class="pointer-events-none absolute left-0 top-0 font-display text-6xl font-bold text-neon-pink/25" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="relative text-2xl">{st.title}</h3>
            <p class="relative mt-3">{st.text}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
