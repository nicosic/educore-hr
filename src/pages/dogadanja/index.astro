---
import Base from "@/layouts/Base.astro";
import Card from "@/components/Card.astro";
import EventCard from "@/components/EventCard.astro";
import FormStatus from "@/components/FormStatus.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { featuredEvent } from "@/data/events";
import { formatEur } from "@/lib/money";
import { fromPrices, listPublicEvents } from "@/server/events";

export const prerender = false;

const now = Date.now();
const list = await listPublicEvents(Astro.locals.db, now);
const prices = await fromPrices(Astro.locals.db, list.map((e) => e.id), now);
// Javni popis smije kratko u cache (CDN i preglednik).
Astro.response.headers.set("cache-control", "public, max-age=60, s-maxage=60");
---
<Base title="Događanja" description="Nadolazeće edukacije, radionice i masterclassovi eduCORE platforme, uživo i online.">
  <section class="container-page pt-14 md:pt-20">
    <SectionHeading
      as="h1"
      eyebrow="Događanja"
      title="Nadolazeće edukacije"
      lead={list.length > 0
        ? "Prijavite se uživo ili online. Za grupne prijave cijelog tima izdajemo jedan račun na tvrtku."
        : "Prijave za prve edukacije otvaramo početkom 2027. Ostavite e-adresu i prvi ćete saznati termin i cijenu."}
    />
  </section>

  {
    list.length > 0 ? (
      <section class="container-page mt-12 grid gap-5 lg:grid-cols-2">
        {list.map((e) => (
          <EventCard event={e} fromPrice={prices[e.id] != null ? formatEur(prices[e.id]) : null} />
        ))}
      </section>
    ) : (
      <section class="container-page mt-12">
        <article class="flex min-h-80 flex-col justify-between rounded-[var(--radius-card)] bg-pink p-8 md:p-10">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-ink/70">Najava • {featuredEvent.when}</p>
            <h2 class="mt-4 text-3xl md:text-4xl">{featuredEvent.title}</h2>
            <p class="mt-4 text-2xl font-semibold">{featuredEvent.question}</p>
          </div>
          <ul class="mt-8 flex flex-wrap gap-2">
            {featuredEvent.tags.map((t) => <li class="rounded-full bg-white/70 px-4 py-1.5 text-sm font-medium">{t}</li>)}
          </ul>
        </article>
      </section>
    )
  }

  <section class="container-page mt-5">
    <form id="forma" method="post" action="/api/obavijesti" class="grid gap-6 rounded-[var(--radius-card)] bg-mint p-8 md:grid-cols-[1fr_1.2fr] md:items-end md:p-10">
      <div>
        <h2 class="text-2xl">Obavijesti o novim edukacijama</h2>
        <p class="mt-3 leading-relaxed">Poslat ćemo vam e-poruku kad otvorimo nove prijave. Bez spama, a odjaviti se možete jednim klikom.</p>
      </div>
      <div>
        <FormStatus success="Hvala! Javit ćemo vam se kad otvorimo prijave." error="Upišite ispravnu e-adresu i potvrdite privolu." />
        <div class="flex flex-col gap-3 sm:flex-row">
          <label class="block flex-1">
            <span class="sr-only">E-pošta</span>
            <input class="field" type="email" name="email" required maxlength="254" autocomplete="email" placeholder="vasa@adresa.hr" />
          </label>
          <button class="btn btn-primary">Prijavi se</button>
        </div>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Web stranica <input name="web" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="mt-4 flex gap-3 text-sm">
          <input type="checkbox" name="privola" value="da" required class="mt-0.5 size-5 accent-teal" />
          <span>Pristajem primati obavijesti o edukacijama eduCORE-a. <a href="/privatnost" class="underline">Zaštita privatnosti</a></span>
        </label>
      </div>
    </form>
  </section>

  <section class="container-page mt-20">
    <h2 class="text-2xl md:text-3xl">Kako izgleda prijava</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      <Card title="Uživo ili online" tone="sky"><p>Za svaki događaj birate mjesto u dvorani ili online sudjelovanje preko Zooma, s osobnom poveznicom za ulaz.</p></Card>
      <Card title="Grupne prijave" tone="butter"><p>Prijavite cijeli tim u jednoj narudžbi i dobijte jedan račun na tvrtku, uz grupni popust.</p></Card>
      <Card title="Potvrda i materijali" tone="lilac"><p>Nakon edukacije dobivate potvrdu o sudjelovanju i pristup materijalima u svom korisničkom prostoru.</p></Card>
    </div>
  </section>
</Base>
