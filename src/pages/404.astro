---
import Base from "@/layouts/Base.astro";
---
<Base title="Stranica nije pronađena" noindex>
  <section class="container-page py-24 text-center">
    <p class="eyebrow">Greška 404</p>
    <h1 class="mt-4 text-4xl md:text-6xl">Ova stranica ne postoji.</h1>
    <p class="mx-auto mt-5 max-w-lg text-lg text-muted">Možda je premještena ili je poveznica neispravna.</p>
    <a href="/" class="btn btn-primary mt-10">Natrag na početnu</a>
  </section>
</Base>
