---
import { and, desc, eq, ne } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import { events, registrations, ticketTypes } from "@/lib/db/schema";
import { formatRange } from "@/lib/time";

export const prerender = false;

const user = Astro.locals.user!;
const rows = await Astro.locals.db
  .select({ reg: registrations, event: events, ticket: ticketTypes })
  .from(registrations)
  .innerJoin(events, eq(events.id, registrations.eventId))
  .innerJoin(ticketTypes, eq(ticketTypes.id, registrations.ticketTypeId))
  .where(and(eq(registrations.attendeeEmail, user.email), ne(registrations.status, "cancelled")))
  .orderBy(desc(events.startsAt));
const now = Date.now();
const upcoming = rows.filter((r) => r.event.endsAt >= now);
const past = rows.filter((r) => r.event.endsAt < now);
---
<Base title="Moj račun" noindex>
  <section class="container-page pt-14 md:pt-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Moj račun</p>
        <h1 class="mt-3 text-4xl md:text-5xl">Moje edukacije</h1>
        <p class="mt-3 text-muted">Prijavljeni ste kao {user.email}.</p>
      </div>
      <div class="flex gap-3">
        {user.isAdmin && <a href="/admin" class="btn btn-secondary !py-2">Admin</a>}
        <form method="post" action="/odjava"><button class="btn btn-secondary !py-2">Odjava</button></form>
      </div>
    </div>

    <h2 class="mt-12 text-2xl">Nadolazeće</h2>
    {
      upcoming.length === 0 ? (
        <p class="mt-4 rounded-2xl bg-white p-6 text-muted ring-1 ring-ink/5">
          Nemate nadolazećih edukacija. <a href="/dogadanja" class="font-medium text-teal hover:underline">Pogledajte događanja</a>.
        </p>
      ) : (
        <ul class="mt-4 space-y-3">
          {upcoming.map(({ reg, event, ticket }) => (
            <li class="rounded-2xl bg-white p-6 ring-1 ring-ink/5">
              <a href={`/dogadanja/${event.slug}`} class="text-lg font-semibold hover:text-teal">{event.title}</a>
              <p class="mt-1 text-muted">{formatRange(event.startsAt, event.endsAt, event.timezone)} • {ticket.name}</p>
              {reg.status === "pending" && <p class="mt-3 text-sm font-medium">Čeka uplatu.</p>}
              {reg.status === "confirmed" && ticket.mode === "online" && reg.zoomJoinUrl && (
                <a href={reg.zoomJoinUrl} class="btn btn-primary mt-4 !py-2" rel="noopener">Pridruži se na Zoomu</a>
              )}
            </li>
          ))}
        </ul>
      )
    }

    {
      past.length > 0 && (
        <>
          <h2 class="mt-12 text-2xl">Završene</h2>
          <ul class="mt-4 space-y-3">
            {past.map(({ event }) => (
              <li class="rounded-2xl bg-white p-6 ring-1 ring-ink/5">
                <p class="font-semibold">{event.title}</p>
                <p class="mt-1 text-muted">{formatRange(event.startsAt, event.endsAt, event.timezone)}</p>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Base>
