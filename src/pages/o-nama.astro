---
import Base from "@/layouts/Base.astro";
import Card from "@/components/Card.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { community, pillars } from "@/data/site";
---
<Base title="O nama" description="eduCORE je regionalna platforma za poslovne edukacije koja povezuje priznate stručnjake, organizacije i polaznike.">
  <section class="container-page pt-14 md:pt-20">
    <SectionHeading
      as="h1"
      eyebrow="O nama"
      title="Nova generacija poslovnih edukacija"
      lead="eduCORE smo pokrenuli jer vjerujemo da dobra edukacija mora biti dvije stvari odjednom: inspirativna i odmah primjenjiva. Okupljamo stručnjake koji o temama ne samo govore, nego ih svakodnevno rješavaju u praksi."
    />
  </section>

  <section class="container-page mt-16 grid gap-10 lg:grid-cols-2">
    <div class="space-y-5 text-lg leading-relaxed">
      <p>
        Organizacije se danas istovremeno nose s pritiskom na ljude, novim propisima, kibernetičkim prijetnjama i sve složenijim
        ugovorima i nabavama. Znanje za sve to postoji, ali je raspršeno između struka, konferencija i internih priručnika.
      </p>
      <p>
        eduCORE ga okuplja na jednom mjestu kroz šest povezanih akademija. Svaka edukacija završava konkretnim alatima, poput
        checklista, predložaka i matrica rizika, te potvrdom o sudjelovanju.
      </p>
      <p>Učimo uživo, online i na zahtjev, u Hrvatskoj i regiji.</p>
    </div>
    <div class="grid gap-5">
      {pillars.map((p) => <Card title={p.title} tone={p.tone}><p>{p.text}</p></Card>)}
    </div>
  </section>

  <section class="container-page mt-20">
    <h2 class="text-3xl md:text-4xl">Zajednica znanja</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {community.map((c) => <Card title={c.title} tone={c.tone}><p>{c.text}</p></Card>)}
    </div>
    <div class="mt-10 rounded-[var(--radius-card)] bg-white p-8 ring-1 ring-ink/5 md:flex md:items-center md:justify-between md:gap-8">
      <div>
        <h3 class="text-2xl">Želite predavati na eduCORE-u?</h3>
        <p class="mt-2 text-muted">Tražimo stručnjake iz prakse koji znanje znaju prenijeti jasno i konkretno.</p>
      </div>
      <a href="/kontakt" class="btn btn-secondary mt-6 shrink-0 md:mt-0">Javite nam se</a>
    </div>
  </section>
</Base>
