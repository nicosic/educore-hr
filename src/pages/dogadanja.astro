---
import Base from "@/layouts/Base.astro";
import Card from "@/components/Card.astro";
import FormStatus from "@/components/FormStatus.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { featuredEvent } from "@/data/events";
---
<Base title="Događanja" description="Nadolazeće edukacije, radionice i masterclassovi eduCORE platforme, uživo i online.">
  <section class="container-page pt-14 md:pt-20">
    <SectionHeading
      as="h1"
      eyebrow="Događanja"
      title="Nadolazeće edukacije"
      lead="Prijave za prve edukacije otvaramo početkom 2027. Ostavite e-adresu i prvi ćete saznati termin i cijenu."
    />
  </section>

  <section class="container-page mt-12 grid gap-5 lg:grid-cols-[1.6fr_1fr]">
    <article class="flex min-h-96 flex-col justify-between rounded-[var(--radius-card)] bg-pink p-8 md:p-10">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-ink/70">Najava • {featuredEvent.when}</p>
        <h2 class="mt-4 text-3xl md:text-4xl">{featuredEvent.title}</h2>
        <p class="mt-4 text-2xl font-semibold">{featuredEvent.question}</p>
      </div>
      <div class="mt-8">
        <ul class="flex flex-wrap gap-2">
          {featuredEvent.tags.map((t) => <li class="rounded-full bg-white/70 px-4 py-1.5 text-sm font-medium">{t}</li>)}
        </ul>
        <p class="mt-6 text-muted">Akademija <a href={`/akademije/${featuredEvent.academy}`} class="font-semibold text-ink underline underline-offset-4">Mind &amp; Leadership</a></p>
      </div>
    </article>

    <form id="forma" method="post" action="/api/obavijesti" class="flex flex-col rounded-[var(--radius-card)] bg-mint p-8">
      <h2 class="text-2xl">Obavijesti me o prijavama</h2>
      <p class="mt-3 leading-relaxed">Poslat ćemo vam e-poruku čim otvorimo prijave. Bez spama, a odjaviti se možete jednim klikom.</p>
      <div class="mt-6"><FormStatus success="Hvala! Javit ćemo vam se kad otvorimo prijave." error="Upišite ispravnu e-adresu i potvrdite privolu." /></div>
      <label class="block">
        <span class="mb-1.5 block font-medium">E-pošta</span>
        <input class="field" type="email" name="email" required maxlength="254" autocomplete="email" />
      </label>
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label>Web stranica <input name="web" tabindex="-1" autocomplete="off" /></label>
      </div>
      <label class="mt-4 flex gap-3 text-sm">
        <input type="checkbox" name="privola" value="da" required class="mt-0.5 size-5 accent-teal" />
        <span>Pristajem primati obavijesti o edukacijama eduCORE-a. <a href="/privatnost" class="underline">Zaštita privatnosti</a></span>
      </label>
      <button class="btn btn-primary mt-6">Prijavi se na obavijesti</button>
    </form>
  </section>

  <section class="container-page mt-20">
    <h2 class="text-2xl md:text-3xl">Kako izgleda prijava</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      <Card title="Uživo ili online" tone="sky"><p>Za svaki događaj birate mjesto u dvorani ili online sudjelovanje preko Zooma, s osobnom poveznicom za ulaz.</p></Card>
      <Card title="Grupne prijave" tone="butter"><p>Prijavite cijeli tim u jednoj narudžbi i dobijte jedan račun na tvrtku, uz grupni popust.</p></Card>
      <Card title="Potvrda i materijali" tone="lilac"><p>Nakon edukacije dobivate potvrdu o sudjelovanju i pristup materijalima u svom korisničkom prostoru.</p></Card>
    </div>
  </section>
</Base>
