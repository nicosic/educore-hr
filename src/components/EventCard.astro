---
import { academyBySlug, toneClass } from "@/data/academies";
import type { EventRow } from "@/server/events";
import { formatDate, formatTime } from "@/lib/time";

type Props = { event: EventRow; fromPrice?: string | null };
const { event: e, fromPrice } = Astro.props;
const academy = academyBySlug(e.academy);
const formatLabel = { offline: "Uživo", online: "Online", hybrid: "Uživo i online" } as const;
---
<a
  href={`/dogadanja/${e.slug}`}
  class:list={["group flex flex-col justify-between rounded-[var(--radius-card)] p-7 transition-transform duration-150 hover:-translate-y-1 md:p-8", toneClass[academy?.tone ?? "mint"]]}
>
  <div>
    <p class="text-sm font-semibold uppercase tracking-wider text-ink/70">{formatDate(e.startsAt, e.timezone)} • {formatTime(e.startsAt, e.timezone)}</p>
    <h3 class="mt-3 text-2xl font-bold">{e.title}</h3>
    {e.subtitle && <p class="mt-2 text-lg">{e.subtitle}</p>}
  </div>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
    <ul class="flex flex-wrap gap-2 text-sm font-medium">
      <li class="rounded-full bg-white/70 px-3 py-1">{formatLabel[e.format]}</li>
      {e.city && e.format !== "online" && <li class="rounded-full bg-white/70 px-3 py-1">{e.city}</li>}
      {academy && <li class="rounded-full bg-white/70 px-3 py-1">{academy.name}</li>}
    </ul>
    <p class="font-semibold">
      {e.status === "cancelled" ? "Otkazano" : fromPrice ? `od ${fromPrice}` : ""}
      <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
    </p>
  </div>
</a>
