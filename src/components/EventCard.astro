---
import { academyBySlug } from "@/data/academies";
import type { EventRow } from "@/server/events";
import { formatDate, formatTime } from "@/lib/time";

type Props = { event: EventRow; fromPrice?: string | null };
const { event: e, fromPrice } = Astro.props;
const academy = academyBySlug(e.academy);
const formatLabel = { offline: "Uživo", online: "Online", hybrid: "Uživo i online" } as const;
---
<a
  href={`/dogadanja/${e.slug}`}
  class="group flex flex-col justify-between rounded-[var(--radius-card)] bg-white p-7 ring-1 ring-line transition hover:-translate-y-1 hover:ring-ink md:p-8"
>
  <div>
    <p class="eyebrow">{formatDate(e.startsAt, e.timezone)} • {formatTime(e.startsAt, e.timezone)}</p>
    <h3 class="mt-4 text-2xl md:text-3xl">{e.title}</h3>
    {e.subtitle && <p class="mt-3 text-lg">{e.subtitle}</p>}
  </div>
  <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
    <ul class="flex flex-wrap gap-2 text-sm font-medium text-ink">
      <li class="rounded-full bg-stone px-3 py-1">{formatLabel[e.format]}</li>
      {e.city && e.format !== "online" && <li class="rounded-full bg-stone px-3 py-1">{e.city}</li>}
      {academy && <li class="rounded-full bg-stone px-3 py-1">{academy.name}</li>}
    </ul>
    <p class:list={["rounded-full px-4 py-1.5 font-semibold text-ink", e.status === "cancelled" ? "bg-neon-pink/20" : "bg-neon"]}>
      {e.status === "cancelled" ? "Otkazano" : fromPrice ? `od ${fromPrice}` : "Detalji"}
      <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
    </p>
  </div>
</a>
