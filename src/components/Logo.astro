---
// Logotip meet.hr. Znak je isto neonsko "m" s ružičastom točkom kao ikona weba.
// variant: "mark" = samo znak, "combo" = znak i naziv, "word" = samo naziv (dosadašnji).
type Props = { class?: string; variant?: "mark" | "combo" | "word" };
const { class: cls = "", variant = "combo" } = Astro.props;
---
{
  variant === "word" ? (
    <span class:list={["inline-flex items-baseline font-display font-extrabold tracking-tight text-ink", cls]}>
      meet<span class="ml-[0.04em] rounded-[0.3em] bg-neon px-[0.18em] text-ink">.hr</span>
    </span>
  ) : (
    <span class:list={["inline-flex items-center gap-[0.35em] font-display font-extrabold tracking-tight text-ink", cls]}>
      <svg viewBox="0 0 64 64" class="size-[1.6em] shrink-0" role="img" aria-label="meet.hr">
        <rect width="64" height="64" rx="15" fill="#0b0d07" />
        <path
          d="M13 46V30.5a7.75 7.75 0 0 1 15.5 0V46M28.5 30.5a7.75 7.75 0 0 1 15.5 0V46"
          fill="none"
          stroke="#d7ff3a"
          stroke-width="7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="53.5" cy="45" r="4.5" fill="#ff4fd1" />
      </svg>
      {variant === "combo" && <span>meet<span class="text-neon-pink">.</span>hr</span>}
    </span>
  )
}
