---
// meet.hr: "meet" u boji teksta, ".hr" na neonskoj pločici (čitljivo i na svijetloj i na tamnoj podlozi).
type Props = { class?: string };
const { class: cls = "" } = Astro.props;
---
<span class:list={["inline-flex items-baseline font-display font-extrabold tracking-tight text-ink", cls]}>
  meet<span class="ml-[0.04em] rounded-[0.3em] bg-neon px-[0.18em] text-ink">.hr</span>
</span>
