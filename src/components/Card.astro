---
import { toneClass, type Tone } from "@/data/academies";
type Props = { title: string; tone: Tone; href?: string; size?: "md" | "lg" };
const { title, tone, href, size = "md" } = Astro.props;
const Tag = href ? "a" : "div";
---
<Tag
  href={href}
  class:list={[
    "group flex flex-col rounded-[var(--radius-card)] p-7",
    toneClass[tone],
    size === "lg" ? "min-h-56" : "min-h-44",
    href && "transition-transform duration-150 hover:-translate-y-1",
  ]}
>
  <h3 class:list={["font-bold", size === "lg" ? "text-2xl" : "text-xl"]}>
    {title}
    {href && <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>}
  </h3>
  <div class="mt-3 leading-relaxed"><slot /></div>
</Tag>
