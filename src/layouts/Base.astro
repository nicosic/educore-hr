---
import "@/styles/global.css";
import Logo from "@/components/Logo.astro";
import { nav, site } from "@/data/site";

type Props = { title?: string; description?: string; noindex?: boolean };
const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | meet.hr` : `meet.hr | ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path, site.url).toString();
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
// Cloudflare Web Analytics (bez kolačića). Token se postavlja pri buildu.
const cfToken = import.meta.env.PUBLIC_CF_WA_TOKEN;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fdfdfd" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hr_HR" />
    <meta property="og:site_name" content="meet.hr" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {(noindex || import.meta.env.PUBLIC_NOINDEX === "1") && <meta name="robots" content="noindex" />}
    {
      cfToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfToken })}
        />
      )
    }
  </head>
  <body>
    <a href="#sadrzaj" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white">
      Preskoči na sadržaj
    </a>

    <header class="sticky top-0 z-40 border-b border-line/70 bg-cream/90 backdrop-blur">
      <div class="container-page flex h-18 items-center justify-between gap-6">
        <a href="/" class="text-2xl" aria-label="meet.hr, početna"><Logo /></a>

        <nav aria-label="Glavna navigacija" class="hidden lg:block">
          <ul class="flex items-center gap-9 text-[0.95rem] font-medium text-ink">
            {
              nav.map((n) => (
                <li>
                  <a
                    href={n.href}
                    aria-current={isActive(n.href) ? "page" : undefined}
                    class:list={["underline-offset-8 transition hover:underline", isActive(n.href) && "underline decoration-neon-pink decoration-[3px]"]}
                  >
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-3">
          <a href="/dogadanja" class="btn btn-secondary hidden !py-2.5 sm:inline-flex">Prijavi se</a>
          <details class="relative lg:hidden">
            <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-ink/15 [&::-webkit-details-marker]:hidden" aria-label="Izbornik">
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </summary>
            <nav aria-label="Mobilna navigacija" class="absolute right-0 mt-3 w-64 rounded-2xl bg-white p-3 shadow-xl ring-1 ring-ink/5">
              <ul>
                {
                  nav.map((n) => (
                    <li>
                      <a href={n.href} class="block rounded-xl px-4 py-3 font-medium hover:bg-cream">
                        {n.label}
                      </a>
                    </li>
                  ))
                }
                <li class="mt-2"><a href="/dogadanja" class="btn btn-primary w-full">Prijavi se</a></li>
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="sadrzaj" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 bg-night text-white/65">
      <div class="container-page grid gap-10 py-16 md:grid-cols-4">
        <div class="md:col-span-2">
          <a href="/" class="text-3xl"><Logo class="!text-white" /></a>
          <p class="mt-4 max-w-sm">Uči. Primijeni. Rasti. Nova generacija poslovnih edukacija za Hrvatsku i regiju.</p>
          <p class="mt-6"><a href={`mailto:${site.email}`} class="font-semibold text-neon underline-offset-4 hover:underline">{site.email}</a></p>
        </div>
        <div>
          <p class="font-display text-lg font-bold text-white">Platforma</p>
          <ul class="mt-4 space-y-2">
            {nav.map((n) => <li><a href={n.href} class="hover:text-neon">{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="font-display text-lg font-bold text-white">Pravno</p>
          <ul class="mt-4 space-y-2">
            <li><a href="/privatnost" class="hover:text-neon">Zaštita privatnosti</a></li>
            <li><a href="/uvjeti" class="hover:text-neon">Uvjeti korištenja</a></li>
            <li><a href="/kolacici" class="hover:text-neon">Kolačići</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="container-page flex flex-col gap-2 py-6 text-sm text-white/45 sm:flex-row sm:justify-between">
          <p>© {year} meet.hr</p>
          <p>Hrvatska • Regija • Online</p>
        </div>
      </div>
    </footer>
  </body>
</html>
