{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "educore-local",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // ---------------------------------------------------------------------------
  // Lokalni razvoj (astro dev / wrangler). D1 i R2 su lokalni (Miniflare).
  // Okruženja: preview (workers.dev) i production (meet.hr), niže pod "env".
  // ---------------------------------------------------------------------------
  "vars": {
    "APP_ENV": "local",
    "APP_URL": "http://localhost:4321",
    "EMAIL_FROM": "info@meet.hr",
    "EMAIL_FROM_NAME": "meet.hr",
    "INQUIRY_TO": "info@meet.hr",
    "EMAIL_TRANSPORT": "log",
    // Adrese koje pri prvoj prijavi automatski dobivaju administratorska prava (odvojene zarezom).
    "ADMIN_EMAILS": "admin@educore.test"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "educore-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "educore-local" }],
  "ratelimits": [
    { "name": "RL_MAGIC_LINK", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],

  "env": {
    // -------------------------------------------------------------------------
    // Preview: privremena adresa na workers.dev (račun educore-hr). Podaci su u EU jurisdikciji.
    // ADMIN_EMAILS i BREVO_API_KEY postavljaju se kao tajne (`wrangler secret put ... --env preview`).
    // -------------------------------------------------------------------------
    "preview": {
      "name": "educore-preview",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "preview",
        "APP_URL": "https://educore-preview.educore-hr.workers.dev",
        "EMAIL_FROM": "info@meet.hr",
        "EMAIL_FROM_NAME": "meet.hr (preview)",
        "INQUIRY_TO": "info@meet.hr",
        "EMAIL_TRANSPORT": "log"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "educore-preview", "database_id": "0662b0db-8afd-4e94-bf35-8076980a3730", "migrations_dir": "drizzle" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "educore-preview", "jurisdiction": "eu" }],
      "ratelimits": [
        { "name": "RL_MAGIC_LINK", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } }
      ]
    },

    // -------------------------------------------------------------------------
    // Produkcija: https://meet.hr (zona meet.hr mora biti u računu educore-hr prije prvog deploya).
    // Tajne: ADMIN_EMAILS, BREVO_API_KEY, BREVO_LIST_ID (`wrangler secret put ... --env production`).
    // www.meet.hr se preusmjerava na meet.hr pravilom za preusmjeravanje u zoni (vidi docs/OBJAVA.md).
    // -------------------------------------------------------------------------
    "production": {
      "name": "meet-hr",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "meet.hr", "custom_domain": true }],
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://meet.hr",
        "EMAIL_FROM": "info@meet.hr",
        "EMAIL_FROM_NAME": "meet.hr",
        "INQUIRY_TO": "info@meet.hr",
        "EMAIL_TRANSPORT": "brevo"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "meet-production", "database_id": "11219d0a-3fab-4e1c-89ad-6830e5733962", "migrations_dir": "drizzle" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "meet-production", "jurisdiction": "eu" }],
      "ratelimits": [
        { "name": "RL_MAGIC_LINK", "namespace_id": "3001", "simple": { "limit": 3, "period": 60 } }
      ]
    }
  }
}
